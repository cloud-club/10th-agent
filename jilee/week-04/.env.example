# 1순위: Groq 무료 (https://console.groq.com, 카드 불필요) — OpenAI 호환
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=qwen/qwen3.8-27b

# 2순위(폴백): OpenRouter 무료 (https://openrouter.ai/keys, 카드 불필요, 하루 50회)
# qwen3.8-27b:free는 공용 풀이라 자주 막혀(429) DeepSeek V4 Flash 무료판을 기본 폴백으로 둔다.
# 1순위가 한도 초과(429)로 오래 막히면 같은 실행 안에서 여기로 자동 전환한다. 비워 두면 폴백 없음.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=sk-or-v1-...
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 회사 적용 시(예정): Gemini API(OpenAI 호환 주소). 유료 등급으로 써야 입력이 학습에 쓰이지 않는다.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=(콘솔에서 확인한 모델명)

# 마스킹(기본 on): 외부 LLM으로 보내는 글의 고객사명·인명을 자리표시자로 바꾼다. 끌 때만 off
# MASKING=on
