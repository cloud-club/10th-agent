# 1순위: Groq 무료 (https://console.groq.com, 카드 불필요) — OpenAI 호환
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=qwen/qwen3.8-27b

# 2순위(폴백): OpenRouter 무료 (https://openrouter.ai/keys, 카드 불필요, 하루 50회)
# qwen3.8-27b:free는 공용 풀이라 자주 막혀(429) nemotron-3-super-120b 무료판을 기본 폴백으로 둔다.
# 1순위가 한도 초과(429)로 오래 막히면 같은 실행 안에서 여기로 자동 전환한다. 비워 두면 폴백 없음.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=sk-or-v1-...
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 회사 적용 시(예정): Gemini API(OpenAI 호환 주소). 유료 등급으로 써야 입력이 학습에 쓰이지 않는다.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=(콘솔에서 확인한 모델명)

# 마스킹(기본 on): 외부 LLM으로 보내는 글의 고객사명·인명을 자리표시자로 바꾼다. 끌 때만 off
# MASKING=on

# 서버에 올릴 때만: 외부 접속을 열고 접속 비밀번호를 건다(비밀번호 없이 HOST만 열면 앱이 시작을 거부한다).
# 브라우저가 묻는 아이디는 아무 값, 비밀번호는 APP_PASSWORD 값. 로컬에서는 세 줄 모두 주석으로 둔다.
# HOST=0.0.0.0
# PORT=8765
# APP_PASSWORD=...

# 라우팅: 1순위가 한 요청에 받는 입력 토큰 한도. 비워 두면 한도를 넘는 요청에서 한 번 부딪혀 배우고 여기에 적는다.
# 이보다 큰 요청만 2순위로 보낸다(작은 요청은 계속 1순위). 1순위를 바꾸면 화면이 이 값을 지운다.
# LLM_MAX_INPUT_TOKENS=7000

# 구글 캘린더 읽어 오기: 캘린더 설정의 "비공개 주소(iCal 형식)". 화면의 연동 탭에서 넣는다. 이 주소를 아는 사람은 일정을 읽을 수 있다.
# GOOGLE_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# 캘린더 내보내기 주소(/calendar.ics?token=...)의 토큰. 처음 열 때 자동으로 만들어진다.
# CALENDAR_FEED_TOKEN=...

# 임베딩 검색(선택): 지난 회의 검색에 뜻으로 찾는 검색기를 더한다. 비워 두면 키워드(BM25)만 쓴다.
# Google AI Studio 키(https://aistudio.google.com/apikey). 무료 등급은 입력이 서비스 개선에 쓰일 수 있어 조각의 고객사명 · 인명은 가려서 보낸다.
# EMBED_API_KEY=AIza...
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
